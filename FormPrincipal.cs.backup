    private readonly List<Juego> _juegos = new();
    private List<Juego> _juegosUndo = new();
    private string _rutaCsvActual = string.Empty;

    // TextBox de búsqueda (añadir desde el diseñador)
    private TextBox? txtBusquedaControl;

